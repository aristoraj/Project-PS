# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Password you type to enter /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Google Cloud OAuth client (Web application) - see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app (used for the Google OAuth redirect)
APP_URL=http://localhost:3000
